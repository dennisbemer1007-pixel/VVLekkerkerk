{
  "name": "vvl-planning-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend:wait\"",
    "dev:frontend:wait": "node scripts/wait-for-api.js && vite",
    "dev:backend": "node --watch src/backend/server.js",
    "dev:frontend": "vite",
    "build": "vite build",
    "build:render": "prisma generate --schema=src/backend/prisma/schema.prisma && vite build",
    "start": "node src/backend/server.js",
    "start:render": "node scripts/render-start.js",
    "setup": "npm run db:generate && npm run db:push",
    "db:generate": "prisma generate --schema=src/backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema=src/backend/prisma/schema.prisma --accept-data-loss",
    "db:seed": "node scripts/seed-mock.js",
    "db:accounts": "node scripts/ensure-role-accounts.js",
    "db:cleanup": "node scripts/db-cleanup.js",
    "db:inspect": "node scripts/db-inspect.js",
    "db:backup": "node scripts/backup-db.js",
    "test": "node scripts/unit-checks.js",
    "test:unit": "node scripts/unit-checks.js",
    "test:api": "node scripts/api-smoke-test.js",
    "test:accept": "node scripts/acceptance-test.js",
    "test:security": "node scripts/security-retest.mjs",
    "demo:users": "node scripts/ensure-role-accounts.js",
    "admin:reset": "node scripts/reset-password.js admin@vvl.local admin123",
    "demo:video": "node scripts/make-demo-video.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.17.1",
    "postcss": "^8.5.25",
    "prisma": "^6.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
