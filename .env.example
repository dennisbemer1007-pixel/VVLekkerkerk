# Kopieer naar .env en pas aan. Commit nooit echte wachtwoorden.

# SQLite (lokaal)
DATABASE_URL="file:./src/backend/prisma/dev.db"

# Persistente datamap in productie (bijv. Render disk: /var/data)
# DATA_DIR=/var/data

PORT=3001
NODE_ENV=development

# Verplicht in productie (niet admin123)
ADMIN_EMAIL=admin@vvl.local
ADMIN_PASSWORD=wijzig-dit-wachtwoord

# Publieke URL van de app (links in e-mail)
# APP_URL=https://planning.example.nl
# CORS_ORIGIN=https://planning.example.nl

# Achter een reverse proxy / Render
# TRUST_PROXY=1

# SMTP-wachtwoord encryptie in de database
# MAIL_SECRET=

# Alleen voor demoservers
# SEED_DEMO=false
