generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Person {
  id               Int          @id @default(autoincrement())
  /** Uniek intern persoonsnummer: 7 cijfers */
  personNumber     String?      @unique
  name             String
  email            String?      @unique
  phone            String?
  photoUrl         String?
  role             String       @default("Vrijwilliger")
  active           Boolean      @default(true)
  /** NONE | FULL (1×/6w) | VR18 (1×/12w) */
  obligation       String       @default("NONE")
  exempted         Boolean      @default(false)
  /** Openstaande inhaaldiensten */
  makeupDue        Int          @default(0)
  /** JSON array van weekdagen 0=zo … 6=za waarop iemand niet kan */
  unavailableWeekdays String    @default("[]")
  /** JSON array: MORNING | AFTERNOON | EVENING */
  preferredSlots   String       @default("[]")
  passwordHash     String?
  inviteToken      String?      @unique
  inviteExpiresAt  DateTime?
  passwordResetToken     String?  @unique
  passwordResetExpiresAt DateTime?
  accountCreatedAt DateTime?
  /** Moment van deactiveren (AVG: contact wissen na bewaartermijn) */
  deactivatedAt    DateTime?
  teamId           Int?
  team             Team?        @relation(fields: [teamId], references: [id])
  /** Ouder-account dat dit kind zonder e-mail beheert */
  guardianId       Int?
  guardian         Person?      @relation("PersonGuardian", fields: [guardianId], references: [id])
  children         Person[]     @relation("PersonGuardian")
  teamMemberships  PersonTeam[]
  enrollments      Enrollment[]
  coordinates      Team[]       @relation("TeamCoordinator")
  sessions         Session[]
  auditLogs        AuditLog[]
  swapRequests     SwapRequest[] @relation("SwapRequester")
  swapOffers       SwapRequest[] @relation("SwapCounterparty")
  notifications    Notification[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  personId  Int
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PersonTeam {
  id        Int      @id @default(autoincrement())
  personId  Int
  teamId    Int
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season    String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([personId, teamId, season])
}

model Team {
  id                   Int       @id @default(autoincrement())
  name                 String
  coordinatorId        Int?
  coordinator          Person?   @relation("TeamCoordinator", fields: [coordinatorId], references: [id])
  matchDurationMinutes Int       @default(90)
  active               Boolean   @default(true)
  /** Wedstrijden tellen mee voor persoonlijke beschikbaarheid */
  availabilityUse      Boolean   @default(true)
  /** Thuiswedstrijden kunnen een teamdienst veroorzaken */
  teamDutyUse          Boolean   @default(false)
  /** JSON: MORNING | SECOND | LAST */
  teamDutySlots        String    @default("[]")
  functionsConfigured  Boolean   @default(false)
  members              Person[]
  memberships          PersonTeam[]
  matches              Match[]
  assignedServices     Service[] @relation("AssignedTeam")
  teamDuties           ServiceTeamDuty[]
  dutyEnrollments      Enrollment[] @relation("EnrollmentForTeam")
  conditionRules       ServiceRule[] @relation("RuleConditionTeam")
}

model Match {
  id          Int      @id @default(autoincrement())
  date        DateTime
  time        String?
  home        Boolean  @default(true)
  opponent    String?
  note        String?
  matchNumber String?
  matchType   String?
  playLevel   String?
  teamId      Int?
  team        Team?    @relation(fields: [teamId], references: [id])
  services    Service[]
}

model Activity {
  id        Int       @id @default(autoincrement())
  name      String
  date      DateTime
  startTime String
  endTime   String
  /** klaverjas | toernooi | feest | ledenavond | opening | overig */
  type      String    @default("overig")
  location  String?
  locked    Boolean   @default(false)
  note      String?
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ServiceRule {
  id                    Int          @id @default(autoincrement())
  name                  String
  weekday               Int?
  startTime             String
  endTime               String
  type                  ServiceType
  required              Int          @default(1)
  slot                  String?
  /** ALWAYS | HOME_MATCH | HOME_MATCH_TEAM | ACTIVITY | MANUAL */
  conditionType         String       @default("ALWAYS")
  conditionTeamId       Int?
  conditionTeam         Team?        @relation("RuleConditionTeam", fields: [conditionTeamId], references: [id])
  conditionTeamName     String?
  conditionActivityType String?
  kickoffAfter          String?
  teamDuty              Boolean      @default(false)
  /** MORNING | SECOND | LAST */
  teamDutySlotRole      String?
  /** Aantal teamplekken voor één thuisspelend team (0 = standaard per shift). */
  teamDutyReserved      Int          @default(0)
  /** Leeftijdsgroep voor teamdienst, bijv. 8 t/m 12 of 13 t/m 17. */
  teamDutyAgeFrom       Int?
  teamDutyAgeTo         Int?
  active                Boolean      @default(true)
  validFrom             DateTime?
  validTo               DateTime?
  sortOrder             Int          @default(0)
  services              Service[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model Service {
  id             Int          @id @default(autoincrement())
  type           ServiceType
  date           DateTime
  time           String
  location       String
  required       Int          @default(2)
  active         Boolean      @default(true)
  draft          Boolean      @default(false)
  locked         Boolean      @default(false)
  /** PERSONAL | TEAM | MIXED */
  kind           String       @default("PERSONAL")
  /** AUTO | MANUAL | YEAR */
  origin         String       @default("AUTO")
  slot           String?
  note           String?
  matchId        Int?
  match          Match?       @relation(fields: [matchId], references: [id])
  assignedTeamId Int?
  assignedTeam   Team?        @relation("AssignedTeam", fields: [assignedTeamId], references: [id])
  teamDuties     ServiceTeamDuty[]
  sourceRuleId   Int?
  sourceRule     ServiceRule? @relation(fields: [sourceRuleId], references: [id])
  activityId     Int?
  activity       Activity?    @relation(fields: [activityId], references: [id])
  enrollments    Enrollment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  serviceId Int
  personId  Int
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  /** SELF | ADMIN | TEAM | AUTO */
  source    String   @default("SELF")
  /** PERSONAL | TEAM */
  kind      String   @default("PERSONAL")
  /** Team waarvan deze inschrijving een gereserveerde teamdienst-plek vult */
  forTeamId Int?
  forTeam   Team?    @relation("EnrollmentForTeam", fields: [forTeamId], references: [id])
  reason    String?
  makeup    Boolean  @default(false)
  noShow    Boolean  @default(false)
  remindedAt DateTime?
  createdAt DateTime @default(now())
  swapsFrom SwapRequest[] @relation("SwapFrom")
  swapsTo   SwapRequest[] @relation("SwapTo")

  @@unique([serviceId, personId])
}

/** Gereserveerde teamdienst-plekken op een bardienst (bijv. 2 voor O12-1). */
model ServiceTeamDuty {
  id        Int     @id @default(autoincrement())
  serviceId Int
  teamId    Int
  reserved  Int     @default(2)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([serviceId, teamId])
}

/** Twee bestaande persoonlijke diensten ruilen. */
model SwapRequest {
  id               Int        @id @default(autoincrement())
  fromEnrollmentId Int
  toEnrollmentId   Int
  fromEnrollment   Enrollment @relation("SwapFrom", fields: [fromEnrollmentId], references: [id], onDelete: Cascade)
  toEnrollment     Enrollment @relation("SwapTo", fields: [toEnrollmentId], references: [id], onDelete: Cascade)
  requesterId      Int
  requester        Person     @relation("SwapRequester", fields: [requesterId], references: [id])
  counterpartyId   Int
  counterparty     Person     @relation("SwapCounterparty", fields: [counterpartyId], references: [id])
  /** PENDING_PEER | PENDING_COMMITTEE (legacy) | APPROVED | REJECTED | CANCELLED */
  status           String     @default("PENDING_PEER")
  matchBlockWarning Boolean   @default(false)
  note             String?
  rejectReason     String?
  decidedById      Int?
  decidedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Notification {
  id        Int       @id @default(autoincrement())
  personId  Int
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  /** SWAP_INCOMING | SWAP_ACCEPTED | SWAP_REJECTED | SWAP_CANCELLED | SWAP_INFO */
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  swapId    Int?
  createdAt DateTime  @default(now())

  @@index([personId, readAt])
  @@index([personId, createdAt])
}

enum ServiceType {
  BAR
  KITCHEN
}

model PlanningRound {
  id                    Int       @id @default(1)
  fromDate              DateTime?
  toDate                DateTime?
  status                String    @default("DRAFT")
  volunteerDeadline     DateTime?
  volunteerNotifiedAt   DateTime?
  mandatoryNotifiedAt   DateTime?
  publishedAt           DateTime?
  official              Boolean   @default(false)
  updatedAt             DateTime  @updatedAt
}

model ClubSettings {
  id                   Int      @id @default(1)
  seasonLabel          String   @default("2026-2027")
  seasonStartMonth     Int      @default(8)
  auditRetainMonths    Int      @default(24)
  inactiveRetainMonths Int      @default(24)
  updatedAt            DateTime @updatedAt
}

model MailSettings {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  host      String   @default("")
  port      Int      @default(587)
  secure    Boolean  @default(false)
  user      String   @default("")
  password  String   @default("")
  fromEmail String   @default("")
  fromName  String   @default("V.V. Lekkerkerk")
  /** JSON: invite, scheduled, reminder, planningReady — leeg = standaardteksten */
  templates String   @default("")
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actor     Person?  @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  Int?
  detail    String   @default("")
  createdAt DateTime @default(now())
}
