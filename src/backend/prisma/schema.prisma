generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Person {
  id               Int          @id @default(autoincrement())
  /** Uniek intern persoonsnummer: 7 cijfers */
  personNumber     String?      @unique
  name             String
  email            String?      @unique
  phone            String?
  photoUrl         String?
  role             String       @default("Vrijwilliger")
  active           Boolean      @default(true)
  /** NONE | FULL (1×/6w) | VR18 (1×/12w) */
  obligation       String       @default("NONE")
  exempted         Boolean      @default(false)
  /** Leeg = vrijgesteld tot je het vinkje uitzet. Gevuld = vrijgesteld t/m deze dag. */
  exemptedUntil    DateTime?
  /** Openstaande inhaaldiensten */
  makeupDue        Int          @default(0)
  /** JSON array van weekdagen 0=zo … 6=za waarop iemand niet kan */
  unavailableWeekdays String    @default("[]")
  /** JSON array: MORNING | AFTERNOON | EVENING */
  preferredSlots   String       @default("[]")
  passwordHash     String?
  inviteToken      String?      @unique
  inviteExpiresAt  DateTime?
  passwordResetToken     String?  @unique
  passwordResetExpiresAt DateTime?
  accountCreatedAt DateTime?
  /** Moment van deactiveren (AVG: contact wissen na bewaartermijn) */
  deactivatedAt    DateTime?
  teamId           Int?
  team             Team?        @relation(fields: [teamId], references: [id])
  /** Ouder-account dat dit kind zonder e-mail beheert */
  guardianId       Int?
  guardian         Person?      @relation("PersonGuardian", fields: [guardianId], references: [id])
  children         Person[]     @relation("PersonGuardian")
  absences         PersonAbsence[]
  teamMemberships  PersonTeam[]
  enrollments      Enrollment[]
  coordinates      Team[]       @relation("TeamCoordinator")
  sessions         Session[]
  auditLogs        AuditLog[]
  swapRequests     SwapRequest[] @relation("SwapRequester")
  swapOffers       SwapRequest[] @relation("SwapCounterparty")
  notifications    Notification[]
  calendarFeed     CalendarFeed?
  /** JSON: pupillen, junioren, senioren. Leeg = niet beschikbaar als scheidsrechter. */
  refereeLevels    String       @default("[]")
  refereeAssignments RefereeAssignment[]
  refereeSwapsRequested RefereeSwap[] @relation("RefereeSwapRequester")
  refereeSwapsReceived  RefereeSwap[] @relation("RefereeSwapCounterparty")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

/** Afwezigheid (alleen barcommissie): persoon wordt niet automatisch ingepland in deze periode */
model PersonAbsence {
  id        Int      @id @default(autoincrement())
  personId  Int
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  fromDate  DateTime
  toDate    DateTime
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, fromDate, toDate])
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  personId  Int
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PersonTeam {
  id        Int      @id @default(autoincrement())
  personId  Int
  teamId    Int
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season    String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([personId, teamId, season])
}

model Team {
  id                   Int       @id @default(autoincrement())
  name                 String
  coordinatorId        Int?
  coordinator          Person?   @relation("TeamCoordinator", fields: [coordinatorId], references: [id])
  matchDurationMinutes Int       @default(90)
  active               Boolean   @default(true)
  /** Wedstrijden tellen mee voor persoonlijke beschikbaarheid */
  availabilityUse      Boolean   @default(true)
  /** Thuiswedstrijden kunnen een teamdienst veroorzaken */
  teamDutyUse          Boolean   @default(false)
  /** JSON: MORNING | SECOND | LAST */
  teamDutySlots        String    @default("[]")
  functionsConfigured  Boolean   @default(false)
  members              Person[]
  memberships          PersonTeam[]
  matches              Match[]
  assignedServices     Service[] @relation("AssignedTeam")
  teamDuties           ServiceTeamDuty[]
  dutyEnrollments      Enrollment[] @relation("EnrollmentForTeam")
  conditionRules       ServiceRule[] @relation("RuleConditionTeam")
  calendarFeed         CalendarFeed?
}

model Match {
  id          Int      @id @default(autoincrement())
  date        DateTime
  time        String?
  home        Boolean  @default(true)
  opponent    String?
  note        String?
  matchNumber String?
  matchType   String?
  playLevel   String?
  teamId      Int?
  team        Team?    @relation(fields: [teamId], references: [id])
  services    Service[]
  refereeAssignment RefereeAssignment?
  updatedAt   DateTime @updatedAt
}

model Activity {
  id        Int       @id @default(autoincrement())
  name      String
  date      DateTime
  startTime String
  endTime   String
  /** klaverjas | toernooi | feest | ledenavond | opening | overig */
  type      String    @default("overig")
  location  String?
  locked    Boolean   @default(false)
  note      String?
  /** Hoeveel bardiensten deze activiteit nodig heeft. Leeg = alleen de gewone dienstregels. */
  barRequired Int?
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ServiceRule {
  id                    Int          @id @default(autoincrement())
  name                  String
  weekday               Int?
  startTime             String
  endTime               String
  type                  ServiceType
  required              Int          @default(1)
  slot                  String?
  /** ALWAYS | HOME_MATCH | HOME_MATCH_TEAM | ACTIVITY | MANUAL */
  conditionType         String       @default("ALWAYS")
  conditionTeamId       Int?
  conditionTeam         Team?        @relation("RuleConditionTeam", fields: [conditionTeamId], references: [id])
  conditionTeamName     String?
  conditionActivityType String?
  kickoffAfter          String?
  teamDuty              Boolean      @default(false)
  /** MORNING | SECOND | LAST */
  teamDutySlotRole      String?
  /** Aantal teamplekken voor één thuisspelend team (0 = standaard per shift). */
  teamDutyReserved      Int          @default(0)
  /** Leeftijdsgroep voor teamdienst, bijv. 8 t/m 12 of 13 t/m 17. */
  teamDutyAgeFrom       Int?
  teamDutyAgeTo         Int?
  active                Boolean      @default(true)
  validFrom             DateTime?
  validTo               DateTime?
  sortOrder             Int          @default(0)
  services              Service[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model Service {
  id             Int          @id @default(autoincrement())
  type           ServiceType
  date           DateTime
  time           String
  location       String
  required       Int          @default(2)
  active         Boolean      @default(true)
  draft          Boolean      @default(false)
  locked         Boolean      @default(false)
  /** PERSONAL | TEAM | MIXED */
  kind           String       @default("PERSONAL")
  /** AUTO | MANUAL | YEAR */
  origin         String       @default("AUTO")
  slot           String?
  note           String?
  matchId        Int?
  match          Match?       @relation(fields: [matchId], references: [id])
  assignedTeamId Int?
  assignedTeam   Team?        @relation("AssignedTeam", fields: [assignedTeamId], references: [id])
  teamDuties     ServiceTeamDuty[]
  sourceRuleId   Int?
  sourceRule     ServiceRule? @relation(fields: [sourceRuleId], references: [id])
  activityId     Int?
  activity       Activity?    @relation(fields: [activityId], references: [id])
  tournamentId   Int?
  tournament     Tournament?  @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  /** bar-1, keuken-2: koppelt een open dienst aan een toernooiblok */
  tournamentShiftKey String?
  enrollments    Enrollment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  serviceId Int
  personId  Int
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  /** SELF | ADMIN | TEAM | AUTO */
  source    String   @default("SELF")
  /** PERSONAL | TEAM */
  kind      String   @default("PERSONAL")
  /** Team waarvan deze inschrijving een gereserveerde teamdienst-plek vult */
  forTeamId Int?
  forTeam   Team?    @relation("EnrollmentForTeam", fields: [forTeamId], references: [id])
  reason    String?
  makeup    Boolean  @default(false)
  noShow    Boolean  @default(false)
  remindedAt DateTime?
  createdAt DateTime @default(now())
  swapsFrom SwapRequest[] @relation("SwapFrom")
  swapsTo   SwapRequest[] @relation("SwapTo")

  @@unique([serviceId, personId])
}

/** Gereserveerde teamdienst-plekken op een bardienst (bijv. 2 voor O12-1). */
model ServiceTeamDuty {
  id        Int     @id @default(autoincrement())
  serviceId Int
  teamId    Int
  reserved  Int     @default(2)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([serviceId, teamId])
}

/** Twee bestaande persoonlijke diensten ruilen. */
model SwapRequest {
  id               Int        @id @default(autoincrement())
  fromEnrollmentId Int
  toEnrollmentId   Int
  fromEnrollment   Enrollment @relation("SwapFrom", fields: [fromEnrollmentId], references: [id], onDelete: Cascade)
  toEnrollment     Enrollment @relation("SwapTo", fields: [toEnrollmentId], references: [id], onDelete: Cascade)
  requesterId      Int
  requester        Person     @relation("SwapRequester", fields: [requesterId], references: [id])
  counterpartyId   Int
  counterparty     Person     @relation("SwapCounterparty", fields: [counterpartyId], references: [id])
  /** PENDING_PEER | PENDING_COMMITTEE (legacy) | APPROVED | REJECTED | CANCELLED */
  status           String     @default("PENDING_PEER")
  matchBlockWarning Boolean   @default(false)
  note             String?
  rejectReason     String?
  decidedById      Int?
  decidedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Notification {
  id        Int       @id @default(autoincrement())
  personId  Int
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  /** SWAP_INCOMING | SWAP_ACCEPTED | SWAP_REJECTED | SWAP_CANCELLED | SWAP_INFO */
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  swapId    Int?
  createdAt DateTime  @default(now())

  @@index([personId, readAt])
  @@index([personId, createdAt])
}

enum ServiceType {
  BAR
  KITCHEN
}

model PlanningRound {
  id                    Int       @id @default(autoincrement())
  /** Korte naam, bijv. "t/m 20 okt" of "najaar" */
  label                 String    @default("Planning")
  fromDate              DateTime?
  toDate                DateTime?
  status                String    @default("DRAFT")
  volunteerDeadline     DateTime?
  volunteerNotifiedAt   DateTime?
  mandatoryNotifiedAt   DateTime?
  publishedAt           DateTime?
  official              Boolean   @default(false)
  /** Actieve periode voor dashboard, Open, Rooster en auto-planning */
  active                Boolean   @default(false)
  updatedAt             DateTime  @updatedAt
}

model ClubSettings {
  id                   Int      @id @default(1)
  seasonLabel          String   @default("2026-2027")
  seasonStartMonth     Int      @default(8)
  auditRetainMonths    Int      @default(24)
  inactiveRetainMonths Int      @default(24)
  /** Uit: geen menu, geen route, API antwoordt 404. */
  tournamentsEnabled   Boolean  @default(false)
  /** Scheidsrechters uit tot een admin de schakelaar aanzet. */
  refereesEnabled      Boolean  @default(false)
  /** Agenda-koppeling uit tot een admin de schakelaar aanzet. */
  calendarEnabled      Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

/** Geheim token voor een iCalendar-feed. Eén per persoon of per team. */
model CalendarFeed {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  /** person | team */
  kind      String
  personId  Int?     @unique
  person    Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  teamId    Int?     @unique
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tournament {
  id                 Int      @id @default(autoincrement())
  name               String
  date               String
  startTime          String   @default("09:00")
  endTime            String   @default("16:00")
  matchMinutes       Int      @default(12)
  changeoverMinutes  Int      @default(3)
  breakEnabled       Boolean  @default(false)
  breakStart         String   @default("12:00")
  breakMinutes       Int      @default(30)
  format             String   @default("poules")
  advance            Int      @default(2)
  categoryMode       String   @default("team")
  refereeMode        String   @default("auto")
  barShifts          Int      @default(0)
  kitchenShifts      Int      @default(0)
  publicToken        String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  fields             TournamentField[]
  teams              TournamentTeam[]
  poules             TournamentPoule[]
  matches            TournamentMatch[]
  services           Service[]
}

model TournamentField {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  key          String
  name         String
  split        String     @default("full")
  partNames    String     @default("{}")
  sortOrder    Int        @default(0)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, key])
}

model TournamentPoule {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  key          String
  name         String
  category     String     @default("JO11")
  sortOrder    Int        @default(0)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, key])
}

model TournamentTeam {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  key          String
  name         String
  category     String     @default("JO9")
  pouleKey     String     @default("")
  sortOrder    Int        @default(0)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, key])
}

model TournamentMatch {
  id                Int        @id @default(autoincrement())
  tournamentId      Int
  engineKey         String
  phase             String
  category          String     @default("")
  pouleKey          String     @default("")
  round             Int        @default(0)
  roundLabel        String     @default("")
  slotIndex         Int?
  partKey           String     @default("")
  homeKey           String     @default("")
  awayKey           String     @default("")
  homeLabel         String     @default("")
  awayLabel         String     @default("")
  refereeKey        String     @default("")
  played            Boolean    @default(false)
  scoreHome         Int        @default(0)
  scoreAway         Int        @default(0)
  penaltiesTeamKey  String     @default("")
  tournament        Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, engineKey])
}

/** Per teamcategorie of een scheidsrechter nodig is. Geen rij = de standaard. */
model RefereeCategory {
  key    String  @id
  needed Boolean
}

/** Eén scheidsrechterplek per thuiswedstrijd. */
model RefereeAssignment {
  id          Int       @id @default(autoincrement())
  matchId     Int       @unique
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  level       String
  categoryKey String
  personId    Int?
  person      Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  /** voorgesteld | bevestigd */
  status      String    @default("voorgesteld")
  /** auto | self | hand */
  source      String    @default("auto")
  openReason  String    @default("")
  swapsFrom   RefereeSwap[] @relation("SwapFromSlot")
  swapsTo     RefereeSwap[] @relation("SwapToSlot")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([personId])
}

/** Ruil tussen twee scheidsrechterplekken. Niet tegen een open plek of een bardienst. */
model RefereeSwap {
  id               Int                @id @default(autoincrement())
  fromAssignmentId Int
  toAssignmentId   Int
  fromAssignment   RefereeAssignment  @relation("SwapFromSlot", fields: [fromAssignmentId], references: [id], onDelete: Cascade)
  toAssignment     RefereeAssignment  @relation("SwapToSlot", fields: [toAssignmentId], references: [id], onDelete: Cascade)
  requesterId      Int
  counterpartyId   Int
  requester        Person             @relation("RefereeSwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  counterparty     Person             @relation("RefereeSwapCounterparty", fields: [counterpartyId], references: [id], onDelete: Cascade)
  /** PENDING | ACCEPTED | REJECTED | CANCELLED */
  status           String             @default("PENDING")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([requesterId, status])
  @@index([counterpartyId, status])
}

model MailSettings {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  host      String   @default("")
  port      Int      @default(587)
  secure    Boolean  @default(false)
  user      String   @default("")
  password  String   @default("")
  fromEmail String   @default("")
  fromName  String   @default("V.V. Lekkerkerk")
  /** JSON: invite, scheduled, reminder, planningReady — leeg = standaardteksten */
  templates String   @default("")
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actor     Person?  @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  Int?
  detail    String   @default("")
  createdAt DateTime @default(now())
}
